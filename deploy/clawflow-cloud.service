# systemd unit for `clawflow cloud serve`.
#
# Install:
#   sudo cp deploy/clawflow-cloud.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now clawflow-cloud
#
# Secrets are loaded from /etc/clawflow/cloud.env (see deploy/clawflow-cloud.env.example).
# The service runs as the unprivileged `clawflow` user against an on-disk
# SQLite store at /var/lib/clawflow/state.db.

[Unit]
Description=ClawFlow cloud API server
Documentation=https://github.com/zhoushoujianwork/clawflow
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clawflow
Group=clawflow

# Secrets — never commit the populated copy.
EnvironmentFile=/etc/clawflow/cloud.env

# Run from the data dir so any relative paths resolve predictably.
WorkingDirectory=/var/lib/clawflow

ExecStart=/usr/local/bin/clawflow cloud serve \
    --host 127.0.0.1 \
    --port 8790 \
    --store sqlite:///var/lib/clawflow/state.db

Restart=on-failure
RestartSec=5s

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/clawflow
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
RestrictRealtime=true

# Logs go to the journal.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
