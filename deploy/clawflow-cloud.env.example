# /etc/clawflow/cloud.env — secrets for the ClawFlow cloud server.
# Copy to /etc/clawflow/cloud.env and chmod 600 (owner: clawflow).
#
# Every value below is REQUIRED unless commented otherwise. The server
# refuses to start with --no-auth in production, so missing any of these
# is a hard failure at boot.

# ---- Server identity ----

# Externally-visible base URL of the cloud server. Used to build OAuth
# redirect_uri and webhook URLs. Must match what the GitHub App is
# configured with.
CLAWFLOW_PUBLIC_URL=https://clawflow.daboluo.cc

# A random 32+ byte secret used to HMAC the OAuth state cookie. Generate
# once with: openssl rand -hex 32
CLAWFLOW_SESSION_KEY=replace-me-with-openssl-rand-hex-32-output

# ---- GitHub App ----

# Numeric App ID from GitHub > Settings > Developer settings > GitHub Apps.
CLAWFLOW_GITHUB_APP_ID=3451934

# App slug (URL fragment). Used to build the "Install on more repos" link.
CLAWFLOW_GITHUB_APP_SLUG=daboluocc

# OAuth client ID issued by GitHub for this App ("Client ID" field).
CLAWFLOW_GITHUB_APP_CLIENT_ID=Iv23liuuIvgr8pI22R9C

# OAuth client secret (Client secrets > Generate). Single-use display
# in the GitHub UI — copy it once and never check it in.
CLAWFLOW_GITHUB_APP_CLIENT_SECRET=replace-me

# Webhook secret configured on the App ("Webhook secret" field). Used
# to verify HMAC signatures on incoming delivery payloads.
CLAWFLOW_GITHUB_APP_WEBHOOK_SECRET=replace-me

# Path to the App's PEM private key on disk. Only used when the cloud
# needs to mint installation tokens (currently optional — webhook
# verification works without it). chmod 600.
# CLAWFLOW_GITHUB_APP_PRIVATE_KEY_PATH=/etc/clawflow/github-app.pem

# ---- Optional: outbound HTTP proxy ----
#
# Some deployments (e.g. Aliyun mainland VMs) cannot reach github.com
# directly. Point HTTPS_PROXY at a local SOCKS/HTTP proxy (mihomo, clash,
# v2ray, etc.) so OAuth callbacks and App API calls succeed.
#
# NO_PROXY keeps loopback (nginx <-> clawflow) direct so the proxy isn't
# in the hot path for every request.
#
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1
